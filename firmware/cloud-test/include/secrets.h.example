// Copy this file to secrets.h (same folder) and fill in your own values.
// secrets.h is gitignored on purpose — never commit real credentials.
#pragma once

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// Same values as tools/cloud/.env (the device user of the Firebase project).
#define FIREBASE_API_KEY "your-firebase-web-api-key"
#define FIREBASE_EMAIL "device@example.com"
#define FIREBASE_PASSWORD "your-device-user-password"
