// Copy this file to secrets.h (same folder) and fill in your own values.
// secrets.h is gitignored on purpose — never commit real credentials.
#pragma once

// WiFi networks, in order of preference (2.4 GHz only). The device tries them in this order and keeps
// the first that connects; one that is not in range costs ~2.5 s, so put the one you use most first. Add
// or remove lines as you need; every line but the last ends with a comma.
#define WIFI_NETWORKS \
  {"your-wifi-name", "your-wifi-password"}, \
  {"your-phone-hotspot", "its-password"}

// The older form, a single network, still works when WIFI_NETWORKS is not defined:
//   #define WIFI_SSID "your-wifi-name"
//   #define WIFI_PASSWORD "your-wifi-password"

// Same values as tools/cloud/.env (the device user of the Firebase project).
#define FIREBASE_API_KEY "your-firebase-web-api-key"
#define FIREBASE_EMAIL "device@example.com"
#define FIREBASE_PASSWORD "your-device-user-password"
