# Copiá este archivo como tools/cloud/.env y completalo. tools/cloud/.env está en
# .gitignore: NUNCA subas credenciales al repositorio ni las pegues en un chat/issue.
# Lo leen fake_device.py y check_rules.py.

# Realtime Database > Datos: la URL que aparece arriba, sin barra final.
# (Si elegiste otra región: https://<proyecto>-default-rtdb.<region>.firebasedatabase.app)
FIREBASE_DATABASE_URL=https://<proyecto>-default-rtdb.firebaseio.com

# Configuración del proyecto > General > "Clave de API web" (identifica al proyecto;
# la seguridad la dan las reglas y el login, no esta clave).
FIREBASE_API_KEY=

# Authentication > Users: el usuario (email/contraseña) que usa SOLO el dispositivo.
FIREBASE_EMAIL=
FIREBASE_PASSWORD=

# Mismo valor que deviceId en web/js/cloud-config.js (/devices/<id> en la base).
PULSOX_DEVICE_ID=pulsox-4ba0e4ea46d7
